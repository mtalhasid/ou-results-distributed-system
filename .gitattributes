# Ensure consistent line endings
mvnw text eol=lf
*.cmd text eol=crlf

# Exclude Python benchmark reports, chart generators, and seed scripts from language statistics
load-tests/** linguist-detectable=false
*.py linguist-detectable=false

# Exclude PowerShell orchestration scripts, test suites, and automation from language statistics
scripts/** linguist-detectable=false
tests/** linguist-detectable=false
*.ps1 linguist-detectable=false
*.psm1 linguist-detectable=false
*.psd1 linguist-detectable=false

# Exclude compiled TypeScript build output from language statistics
result-ingestion-service/dist/** linguist-vendored

