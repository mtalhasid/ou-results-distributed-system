# Service URLs should use each Neon shard's pooled JDBC endpoint.
# Bulk-load URLs should be the direct Neon connection strings for psql.
# Copy these placeholders to your local .env and replace them there.
# Never put real credentials in .env.example or commit .env.
SHARD_1_PRIMARY=postgresql://YOUR-SHARD-1-POOLED-URL
SHARD_1_PRIMARY_REPLICA=postgresql://YOUR-SHARD-1-REPLICA-URL
SHARD_2_PRIMARY=postgresql://YOUR-SHARD-2-POOLED-URL
SHARD_2_PRIMARY_REPLICA=postgresql://YOUR-SHARD-2-REPLICA-URL
